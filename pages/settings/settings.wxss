/** 设置页样式 **/

.page-container {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

/* 统计 */
.stats-section { margin-bottom: 36rpx; }

.stats-grid {
  display: flex;
  margin-bottom: 16rpx;
}

.stat-card {
  flex: 1;
  text-align: center;
  padding: 24rpx 16rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF6B81;
  margin-bottom: 6rpx;
}

.stat-txt {
  font-size: 22rpx;
  color: #999999;
}

/* 参数设置 */
.settings-section { margin-bottom: 36rpx; }

.setting-item {
  padding: 24rpx 30rpx;
  margin-bottom: 16rpx;
}

.setting-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.setting-label {
  font-size: 28rpx;
  color: #333333;
}

.setting-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B81;
}

.slider-range {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #CCCCCC;
  margin-top: 4rpx;
}

/* 数据管理 */
.data-section { margin-bottom: 36rpx; }

.data-actions {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
  margin-bottom: 20rpx;
}

.data-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 16rpx;
  border: none;
  padding: 0;
  text-align: center;
}

.data-btn::after { border: none; }

.data-tip {
  font-size: 24rpx;
  color: #CCCCCC;
  line-height: 1.6;
  text-align: center;
  padding: 0 20rpx;
}

/* 危险操作 */
.danger-section {
  margin-bottom: 40rpx;
  display: flex;
  justify-content: center;
}

.danger-btn {
  background: transparent;
  color: #FF5252;
  font-size: 26rpx;
  border: 1rpx solid #FFCDD2;
  border-radius: 12rpx;
  padding: 14rpx 40rpx;
  text-align: center;
  line-height: 1;
}

.danger-btn::after { border: none; }

.version-info {
  text-align: center;
  font-size: 24rpx;
  color: #CCCCCC;
  margin-top: 20rpx;
}

/* ========== 弹窗通用 ========== */

.popup-small {
  max-height: 60vh;
}

.popup-subtitle {
  font-size: 24rpx;
  color: #CCCCCC;
  text-align: center;
  margin-top: -20rpx;
  margin-bottom: 24rpx;
}

.btn-confirm {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  font-size: 28rpx;
}

.btn-confirm::after { border: none; }

/* ========== 导入方式选择 ========== */

.method-actions {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.method-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  background: #FFF5F5;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  text-align: center;
}

.method-btn::after { border: none; }

.method-btn:active {
  border-color: #FF6B81;
  background: #FFF0F3;
}

.method-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.method-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 6rpx;
}

.method-desc {
  font-size: 24rpx;
  color: #999999;
}

/* ========== 手动导入 ========== */

.popup-manual {
  max-height: 85vh;
}

/* 月份头 */
.manual-month-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  margin-bottom: 10rpx;
}

.month-arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #FF6B81;
}

.month-title-small {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
}

.month-title-tappable {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.month-title-tappable:active {
  background: #FFE4E8;
}

/* 星期头 */
.manual-weekday-row {
  display: flex;
  margin-bottom: 6rpx;
}

.manual-weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  padding: 8rpx 0;
}

/* 日历网格 */
.manual-calendar {
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.manual-week-row {
  display: flex;
}

.manual-day {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.manual-day.empty { background: transparent; }

.manual-day-num {
  font-size: 26rpx;
  color: #333333;
  z-index: 1;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
}

/* 高亮区间 */
.manual-day.in-range {
  background: rgba(255, 107, 129, 0.15);
}

.manual-day.range-start .manual-day-num,
.manual-day.range-end .manual-day-num {
  background: #FF6B81;
  color: #FFFFFF;
  font-weight: 700;
}

.manual-day.future .manual-day-num {
  color: #CCCCCC;
}

/* 已选区间提示 */
.manual-range-hint {
  text-align: center;
  font-size: 26rpx;
  color: #FF6B81;
  margin-bottom: 16rpx;
  padding: 10rpx;
  background: #FFF5F5;
  border-radius: 10rpx;
}

/* 添加操作按钮组 */
.add-actions {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.add-record-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 0;
  margin-right: 16rpx;
}

.add-record-btn::after { border: none; }

.skip-month-btn {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #999999;
  background: #F5F5F5;
  border-radius: 16rpx;
  text-align: center;
  white-space: nowrap;
}

.skip-month-btn:active {
  background: #FFE4E8;
  color: #FF6B81;
}

/* 待导入列表 */
.pending-list {
  margin-top: 24rpx;
  background: #FFF5F5;
  border-radius: 16rpx;
  padding: 20rpx;
}

.pending-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 14rpx;
}

.pending-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
}

.pending-item:last-child {
  border-bottom: none;
}

.pending-info {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-right: 6rpx;
  flex: 1;
}

.pending-dates {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.pending-tag {
  font-size: 22rpx;
  color: #999999;
}

.pending-dates.pending-skipped {
  color: #999999;
  font-style: italic;
}

.pending-remove {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #CCCCCC;
}

/* 底部操作 */
.manual-actions {
  display: flex;
  margin-bottom: 16rpx;
  margin-top: 24rpx;
}

.manual-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  font-size: 28rpx;
  border-radius: 16rpx;
}

.manual-cancel::after { border: none; }

.manual-confirm {
  flex: 2;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  font-size: 28rpx;
}

.manual-confirm::after { border: none; }

/* ========== 导入结果弹窗 ========== */

.import-detail {
  text-align: center;
  margin-bottom: 30rpx;
}

.import-row {
  display: flex;
  justify-content: center;
  margin-right: 10rpx;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

.import-bold {
  font-weight: 700;
  color: #FF6B81;
}

.import-bold.new { color: #4CAF50; }

/* 可点击的统计卡片 */
.stat-card-tappable:active {
  opacity: 0.7;
  transform: scale(0.97);
}

/* ========== 历史记录弹窗 ========== */

.popup-history {
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}

.history-empty {
  text-align: center;
  font-size: 28rpx;
  color: #CCCCCC;
  padding: 60rpx 0;
}

.history-scroll {
  flex: 1;
  max-height: 60vh;
}

/* 搜索栏 */
.history-search {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.history-search > picker {
  flex: 1;
}

.history-search-input {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.history-search-input.has-value {
  background: #FFF0F3;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #CCCCCC;
}

.search-value {
  font-size: 26rpx;
  color: #FF6B81;
  font-weight: 500;
}

.search-clear {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999999;
  margin-left: 12rpx;
}

.history-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.history-item:last-child {
  border-bottom: none;
}

/* 没来记录 */
.history-item-skipped {
  opacity: 0.65;
}

.history-skipped-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: #F0F0F0;
  color: #999999;
}

.history-item-main {
  flex: 1;
  min-width: 0;
}

.history-delete {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-left: 10rpx;
  flex-shrink: 0;
}

.history-delete:active {
  opacity: 0.5;
}

.history-dates {
  display: flex;
  align-items: center;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.history-date-range {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.history-active-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(255, 107, 129, 0.12);
  color: #FF6B81;
}

.history-meta {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.history-sep {
  margin: 0 8rpx;
  color: #CCCCCC;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  margin-right: 8rpx;
}

.history-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  background: #FFF5F5;
  color: #999999;
}
