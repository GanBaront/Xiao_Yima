/** 首页样式 **/

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx 40rpx;
  box-sizing: border-box;
}

/* Hero 区域 */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
  margin-bottom: 20rpx;
}

.hero-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 28rpx;
  color: #999999;
}

/* 状态标签 */
.status-badge {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.status-badge.in-period {
  background: rgba(255, 107, 129, 0.15);
  color: #FF6B81;
}

.status-badge.waiting {
  background: rgba(255, 107, 129, 0.08);
  color: #FF6B81;
}

.status-badge.overdue {
  background: rgba(255, 152, 0, 0.15);
  color: #FF9800;
}

/* 大圆圈 */
.hero-circle {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.in-period-circle {
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 129, 0.35);
}

.waiting-circle {
  background: linear-gradient(135deg, #FFB6C1, #FFD0D6);
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 129, 0.2);
}

.hero-number {
  font-size: 96rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.hero-unit {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.hero-label {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: #999999;
}

/* 操作按钮 */
.action-section {
  width: 100%;
  margin-top: 60rpx;
  margin-bottom: 40rpx;
  display: flex;
  justify-content: center;
}

.btn-main {
  width: 400rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  padding: 0;
}

.btn-main::after {
  border: none;
}

.btn-start {
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 129, 0.35);
}

.btn-end {
  background: linear-gradient(135deg, #FF8A80, #FF5252);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 82, 82, 0.3);
}

/* 统计卡片 */
.stats-row {
  display: flex;
  width: 100%;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 20rpx;
  margin-right: 20rpx;
}

.stat-item:last-child {
  margin-right: 0;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF6B81;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

/* 弹窗 */
.popup-subtitle {
  font-size: 24rpx;
  color: #CCCCCC;
  text-align: center;
  margin-top: -20rpx;
  margin-bottom: 24rpx;
}

.popup-actions {
  display: flex;
  margin-top: 40rpx;
}

.popup-actions > button {
  margin-right: 20rpx;
}

.popup-actions > button:last-child {
  margin-right: 0;
}

.btn-skip {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  font-size: 28rpx;
}

.btn-skip::after {
  border: none;
}

.btn-confirm {
  flex: 2;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  font-size: 28rpx;
}

.btn-confirm::after {
  border: none;
}
