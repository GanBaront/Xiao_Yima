/** app.wxss **/

/* CSS 变量 — 莫兰迪粉色系 */
page {
  --primary: #FF6B81;
  --primary-light: #FFB6C1;
  --primary-bg: #FFF5F5;
  --primary-soft: #FFE4E8;
  --text-primary: #333333;
  --text-secondary: #999999;
  --text-hint: #CCCCCC;
  --white: #FFFFFF;
  --border: #F0F0F0;
  --shadow: rgba(255, 107, 129, 0.15);

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #333333;
  background-color: #FFF5F5;
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

/* flex 布局辅助 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 129, 0.15);
}

/* 主按钮 */
.btn-primary {
  background: #FF6B81;
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 24rpx 60rpx;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.85;
}

/* 次要按钮 */
.btn-outline {
  background: transparent;
  color: #FF6B81;
  border: 2rpx solid #FF6B81;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 18rpx 40rpx;
  text-align: center;
}

/* 弹窗遮罩 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 底部弹出面板 */
.popup-panel {
  background: #FFFFFF;
  border-radius: 30rpx 30rpx 0 0;
  width: 100%;
  max-height: 75vh;
  padding: 40rpx 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333333;
}

/* 标签选择器 */
.tag-section {
  margin-bottom: 30rpx;
}

.tag-section-title {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.tag-item {
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #FFF5F5;
  color: #999999;
  border: 2rpx solid transparent;
  margin: 8rpx;
}

.tag-item.active {
  background: #FF6B81;
  color: #FFFFFF;
  border-color: #FF6B81;
}

/* 关闭按钮 */
.popup-close {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999999;
}
